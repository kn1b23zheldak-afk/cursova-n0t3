@echo off
chcp 65001 > nul
title n0t3 - Вебзастосунок нотаток та цифрових матеріалів

echo ======================================================================
echo    n0t3: Вебзастосунок нотаток та цифрових матеріалів
echo ======================================================================
echo.

python --version >nul 2>&1
if errorlevel 1 (
    echo [ПОМИЛКА] Python не знайдено в системі! Будь ласка, встановіть Python 3.
    pause
    exit /b 1
)

echo [1/3] Перевірка та встановлення необхідних бібліотек...
python -m pip install -r requirements.txt --quiet

echo [2/3] Запуск веб-сервера додатку на http://127.0.0.1:5000 ...
start "" "http://127.0.0.1:5000"

echo [3/3] Сервер успішно працює! Для зупинки натисніть Ctrl+C.
echo.
python app.py

pause
